{
  "name": "vscode-snapshot-lsp",
  "displayName": "Snapshot DSL",
  "description": "Snapshot DSL 的 VS Code 语言服务扩展",
  "version": "1.1.1",
  "publisher": "muedsa",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muedsa/vscode-snapshot-lsp.git"
  },
  "bugs": {
    "url": "https://github.com/muedsa/vscode-snapshot-lsp/issues"
  },
  "homepage": "https://github.com/muedsa/vscode-snapshot-lsp#readme",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "vscode": "^1.101.0"
  },
  "icon": "images/icon.png",
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "snapshot",
        "aliases": [
          "Snapshot",
          "snapshot"
        ],
        "extensions": [
          ".snapshot"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "colors": [
      {
        "id": "snapshot.tagName",
        "description": "Snapshot 标签名",
        "defaults": {
          "light": "#0000FF",
          "dark": "#569CD6",
          "highContrast": "#4FC1FF"
        }
      },
      {
        "id": "snapshot.attributeName",
        "description": "Snapshot 属性名",
        "defaults": {
          "light": "#0451A5",
          "dark": "#9CDCFE",
          "highContrast": "#9CDCFE"
        }
      },
      {
        "id": "snapshot.string",
        "description": "Snapshot 属性值",
        "defaults": {
          "light": "#A31515",
          "dark": "#CE9178",
          "highContrast": "#F48771"
        }
      },
      {
        "id": "snapshot.colorValue",
        "description": "Snapshot 颜色属性值",
        "defaults": {
          "light": "#795E26",
          "dark": "#D7BA7D",
          "highContrast": "#FFCC66"
        }
      },
      {
        "id": "snapshot.numberValue",
        "description": "Snapshot 数字属性值",
        "defaults": {
          "light": "#098658",
          "dark": "#B5CEA8",
          "highContrast": "#B5CEA8"
        }
      },
      {
        "id": "snapshot.booleanValue",
        "description": "Snapshot 布尔属性值",
        "defaults": {
          "light": "#0000FF",
          "dark": "#569CD6",
          "highContrast": "#4FC1FF"
        }
      },
      {
        "id": "snapshot.enumValue",
        "description": "Snapshot 枚举属性值",
        "defaults": {
          "light": "#AF00DB",
          "dark": "#C586C0",
          "highContrast": "#D670D6"
        }
      },
      {
        "id": "snapshot.comment",
        "description": "Snapshot 注释",
        "defaults": {
          "light": "#008000",
          "dark": "#6A9955",
          "highContrast": "#7CA668"
        }
      },
      {
        "id": "snapshot.cdata",
        "description": "Snapshot CDATA 文本",
        "defaults": {
          "light": "#A31515",
          "dark": "#CE9178",
          "highContrast": "#F48771"
        }
      },
      {
        "id": "snapshot.punctuation",
        "description": "Snapshot 标签标点",
        "defaults": {
          "light": "#800000",
          "dark": "#808080",
          "highContrast": "#FFFFFF"
        }
      }
    ],
    "commands": [
      {
        "command": "snapshot.restartLanguageServer",
        "title": "重启语言服务器",
        "category": "Snapshot"
      }
    ]
  },
  "scripts": {
    "build": "pnpm run check && node scripts/build.mjs",
    "watch": "pnpm run check && node scripts/build.mjs --watch",
    "check": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write src test scripts .github .vscode package.json tsconfig.json language-configuration.json pnpm-workspace.yaml README.md CHANGELOG.md RELEASING.md .prettierrc.json",
    "format:check": "prettier --check src test scripts .github .vscode package.json tsconfig.json language-configuration.json pnpm-workspace.yaml README.md CHANGELOG.md RELEASING.md .prettierrc.json",
    "notices:generate": "node scripts/notices.mjs --write",
    "notices:check": "node scripts/notices.mjs --check",
    "release:check": "node scripts/check-release.mjs",
    "test": "pnpm run build && node --test test/*.test.cjs",
    "test:extension": "pnpm run build && node scripts/test-extension-host.mjs",
    "test:vsix": "pnpm run package && node scripts/test-vsix.mjs",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "pnpm run notices:check && pnpm run build"
  },
  "dependencies": {
    "@muedsa/snapshot-lsp": "^0.3.0",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/vscode": "^1.101.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "jszip": "^3.10.2",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3"
  }
}
